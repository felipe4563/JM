# Copiar a .env en el VPS (cp .env.example .env) y cambiar TODOS los valores.
# Generar claves seguras con:  openssl rand -base64 32

DB_PASSWORD=cambia_esto
DB_ROOT_PASSWORD=cambia_esto_tambien
JWT_SECRET=cambia_esto_por_una_clave_larga

# Puerto local donde escucha el contenedor web (el nginx del VPS reenvía aquí).
# Cámbialo si ya lo usa otro sistema del VPS.
WEB_PORT=3120
